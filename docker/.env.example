# Copy to docker/.env and adjust. Used by docker-compose.prod.yml.

# Domain pointing at this server; Caddy gets a certificate for it.
DOMAIN=gif.example.com

# Pull a published image instead of building from source, e.g.
# IMAGE=ghcr.io/viktorkorkishko/simple-gif-editor:latest

MAX_UPLOAD_MB=100
MAX_CLIP_SECONDS=60
MAX_CONCURRENT_JOBS=2
JOB_WAIT_S=30
FFMPEG_TIMEOUT_S=120
